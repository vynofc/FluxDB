<Window x:Class="FluxDB.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename" Height="150" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#252526"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Enter new name:" Foreground="#cccccc" FontSize="13" Margin="0,0,0,8"/>
        
        <TextBox x:Name="txtName" Grid.Row="1" 
                 Background="#1e1e1e" 
                 Foreground="#cccccc" 
                 BorderBrush="#3c3c3c"
                 Padding="10,8"
                 FontSize="14"
                 CaretBrush="#cccccc"
                 KeyDown="TxtName_KeyDown"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Width="80" Padding="10,6" Click="BtnCancel_Click"
                    Background="#3c3c3c" Foreground="#cccccc" BorderThickness="0"/>
            <Button Content="OK" Width="80" Padding="10,6" Click="BtnOk_Click" Margin="10,0,0,0"
                    Background="#0078d4" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
