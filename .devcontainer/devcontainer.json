{
	"image": "mcr.microsoft.com/devcontainers/universal:2",
	"features": {
		"ghcr.io/wxw-matt/devcontainer-features/command_runner:0": {},
		"ghcr.io/jpawlowski/devcontainer-features/powershell-extended:2": {
			"updateModulesHelp": true,
			"installOhMyPosh": true,
			"installOhMyPoshConfig": true,
			"version": "latest",
			"installMethod": "package",
			"updatePSResourceGet": "release",
			"updatePSReadLine": "release"
		},
		"ghcr.io/devcontainer-config/features/dot-config:4": {},
		"ghcr.io/postfinance/devcontainer-features/dotnet:1": {
			"version": "10.0",
			"additionalVersions": "8.0,9.0",
			"dotnetRuntimeVersions": "9.0",
			"aspNetCoreRuntimeVersions": "8.0.15",
			"workloads": "wasm-tools"
		},
		"ghcr.io/devcontainers/features/dotnet:2": {},
		"postCreateCommand": "sudo apt-get update && sudo apt-get install -y mono-devel"
	}
}