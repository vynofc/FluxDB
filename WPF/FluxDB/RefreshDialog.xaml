<Window x:Class="FluxDB.RefreshDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Refresh Options" Height="260" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1e1e1e" Foreground="#cccccc">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Choose what to refresh:" FontWeight="Bold" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Margin="0,4,0,4">
            <RadioButton x:Name="rbEntire" Content="Entire index (refresh all files in root folder)"
                         Margin="0,4" IsChecked="True" Foreground="#cccccc" GroupName="RefreshChoice"/>
            <RadioButton x:Name="rbView" Content="Current view folder only"
                         Margin="0,4" Foreground="#cccccc" GroupName="RefreshChoice"/>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <RadioButton x:Name="rbSelect" Content="Specific folder:"
                             VerticalAlignment="Center" Foreground="#cccccc" GroupName="RefreshChoice"/>
                <TextBox x:Name="txtSelectedFolder" Width="220" Margin="8,0,8,0" IsReadOnly="True"
                         Background="#252526" Foreground="#cccccc" BorderBrush="#3c3c3c"/>
                <Button x:Name="btnBrowse" Content="Browse..." Width="80" Click="BtnBrowse_Click"
                        Background="#0078d4" Foreground="White" BorderThickness="0" Padding="8,4" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Cancel" Width="80" Margin="4" Click="BtnCancel_Click"
                    Background="#252526" Foreground="#cccccc" BorderBrush="#3c3c3c" BorderThickness="1" Padding="8,4" Cursor="Hand"/>
            <Button x:Name="btnOk" Content="OK" Width="80" Margin="4" Click="BtnOk_Click"
                    Background="#0078d4" Foreground="White" BorderThickness="0" Padding="8,4" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>