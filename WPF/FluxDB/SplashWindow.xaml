<Window x:Class="FluxDB.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starting FluxDB" Height="360" Width="520" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True">
    <Border Background="#FF1E1E1E" CornerRadius="10" Padding="16" BorderBrush="#66000000" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,8">
                <!-- Larger logo -->
                <Image x:Name="imgLogo" Width="180" Height="180" />
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="txtMessage" Text="Starting FluxDB..." Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,8" />
                <ProgressBar x:Name="pb" Width="440" Height="14" IsIndeterminate="False" Minimum="0" Maximum="100" Value="0" Margin="0,8" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancel" Width="80" Height="26" Content="Cancel" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>