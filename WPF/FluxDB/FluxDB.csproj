<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>FluxDB</RootNamespace>
    <AssemblyName>FluxDB</AssemblyName>
    <ApplicationIcon>FluxDB-icon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119.0" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="FluxDB-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="FluxDB-icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="GenerateAssemblyVersionFromFile" BeforeTargets="BeforeBuild">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\..\..\version.txt">
      <Output TaskParameter="Lines" ItemName="_VersionLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_AppVersion>@(_VersionLines->'%(Identity)', '')</_AppVersion>
      <_AppVersionNumeric>$([System.Text.RegularExpressions.Regex]::Match($(_AppVersion), '^\d+(\.\d+)*'))</_AppVersionNumeric>
    </PropertyGroup>
    <ItemGroup>
      <_VersionFileLines Include="// Auto-generated from version.txt — nicht manuell bearbeiten." />
      <_VersionFileLines Include="using System.Reflection%3B" />
      <_VersionFileLines Include="[assembly: AssemblyVersion(&quot;$(_AppVersionNumeric)&quot;)]" />
      <_VersionFileLines Include="[assembly: AssemblyFileVersion(&quot;$(_AppVersionNumeric)&quot;)]" />
      <_VersionFileLines Include="[assembly: AssemblyInformationalVersion(&quot;$(_AppVersion)&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\Properties\AssemblyVersion.cs"
                      Lines="@(_VersionFileLines)"
                      Overwrite="true" />
  </Target>
</Project>