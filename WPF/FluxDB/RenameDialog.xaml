<Window x:Class="FluxDB.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename" Height="140" Width="380" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Enter new name:" FontWeight="Bold" Margin="0,0,0,8"/>

        <TextBox x:Name="txtName" Grid.Row="1" Margin="0,4" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Cancel" Width="80" Margin="4" Click="BtnCancel_Click"/>
            <Button x:Name="btnOk" Content="OK" Width="80" Margin="4" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>