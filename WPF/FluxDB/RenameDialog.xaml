<Window x:Class="FluxDB.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename" Height="200" Width="380" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1e1e1e" Foreground="#cccccc">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Enter new name:" FontWeight="Bold" Margin="0,0,0,8"/>

        <TextBox x:Name="txtName" Grid.Row="1" Margin="0,4" VerticalAlignment="Center"
                 Background="#333337" Foreground="#cccccc" BorderBrush="#3c3c3c" Padding="8,6"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Cancel" Width="80" Margin="4" Click="BtnCancel_Click"
                    Background="#252526" Foreground="#cccccc" BorderBrush="#3c3c3c" BorderThickness="1"/>
            <Button x:Name="btnOk" Content="OK" Width="80" Margin="4" Click="BtnOk_Click"
                    Background="#0078d4" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>