<Window
    x:Class="FluxDB.Views.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Starting FluxDB" Height="380" Width="480"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None" AllowsTransparency="True"
    Background="Transparent" ShowInTaskbar="True">

    <Border Background="#FF1E1E1E" CornerRadius="10" Padding="16" BorderBrush="#66000000" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image x:Name="imgLogo" Width="120" Height="120" Margin="0,0,0,16"/>
            <TextBlock Text="FluxDB" FontSize="32" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock x:Name="txtVersion" Text="" FontSize="12" Opacity="0.6"
                       Foreground="#aaaaaa" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock x:Name="txtMessage" Text="Starting FluxDB..." FontSize="13"
                       Foreground="#cccccc" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>