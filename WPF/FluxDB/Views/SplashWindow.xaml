<ui:FluentWindow
    x:Class="FluxDB.Views.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Starting FluxDB" Height="380" Width="480"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round">

    <Grid>
        <ui:TitleBar Visibility="Collapsed" />

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image x:Name="imgLogo" Width="180" Height="180" />
            <TextBlock x:Name="txtMessage" Text="Starting FluxDB..."
                       FontSize="16" HorizontalAlignment="Center" Margin="0,8" />
            <ProgressBar x:Name="pb" Width="440" Height="14"
                         IsIndeterminate="False" Minimum="0" Maximum="100" Value="0" Margin="0,8" />
            <ui:Button x:Name="btnCancel" Content="Cancel" Width="80" HorizontalAlignment="Right"
                       Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>