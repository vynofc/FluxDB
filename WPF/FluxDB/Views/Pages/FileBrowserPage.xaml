<Page x:Class="FluxDB.Views.Pages.FileBrowserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:FluxDB.Views.Controls"
      xmlns:conv="clr-namespace:FluxDB.Converters"
      Title="File Browser">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="btnBack" Margin="0,0,4,0" ToolTip="Back (Alt+Left)"
                               Command="{Binding Navigation.GoBackCommand}"/>
                    <ui:Button x:Name="btnForward" Margin="0,0,4,0" ToolTip="Forward (Alt+Right)"
                               Command="{Binding Navigation.GoForwardCommand}"/>
                    <ui:Button x:Name="btnUp" Margin="0,0,8,0" ToolTip="Up (Alt+Up)"
                               Command="{Binding Navigation.GoUpCommand}"/>
                    <ui:Button x:Name="btnOpenFolder" Content="Open Folder" Margin="0,0,4,0"
                               Command="{Binding SelectFolderCommand}"/>
                    <ui:Button x:Name="btnRefresh" Content="Refresh" Margin="0,0,4,0"
                               Command="{Binding RefreshCommand}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="cmbFilter" Width="120"
                              SelectedValuePath="Content"
                              SelectedValue="{Binding CurrentFilter, Mode=TwoWay}">
                        <ComboBoxItem Content="All Files"/>
                        <ComboBoxItem Content="Images"/>
                        <ComboBoxItem Content="Audio"/>
                        <ComboBoxItem Content="Video"/>
                        <ComboBoxItem Content="Documents"/>
                        <ComboBoxItem Content="Archives"/>
                        <ComboBoxItem Content="Code"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="520" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- File List -->
            <Border Margin="12,8,0,8" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <ListView x:Name="dgFiles"
                          ItemsSource="{Binding Files}"
                          SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          MouseDoubleClick="DgFiles_MouseDoubleClick"
                          BorderThickness="0"
                          Background="Transparent"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="35">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:SymbolIcon
                                            Symbol="{Binding IconSymbol}"
                                            Foreground="{Binding IconColorBrush}"
                                            FontSize="18"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding TypeDisplay}"/>
                            <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeDisplay}"/>
                            <GridViewColumn Header="Tags" Width="120" DisplayMemberBinding="{Binding TagsText}"/>
                            <GridViewColumn Header="Modified" Width="140" DisplayMemberBinding="{Binding ModifiedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

            <!-- Detail Panel -->
            <Border Grid.Column="2" Margin="0,8,12,8" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <local:PreviewPanel x:Name="previewPanel"
                            Visibility="{Binding IsPreviewPanelVisible, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="Details" FontSize="16" FontWeight="Bold" Margin="0,16,0,12"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>

                        <TextBlock Text="Name" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedFile.Name}" FontSize="13" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <TextBlock Text="Path" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedFile.Path}" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <TextBlock Text="Size" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedFile.SizeDisplay}" FontSize="13" Margin="0,0,0,12"/>

                        <TextBlock Text="Created" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedFile.CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="13" Margin="0,0,0,12"/>

                        <TextBlock Text="Modified" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedFile.ModifiedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="13" Margin="0,0,0,16"/>

                        <Separator Margin="0,0,0,16" Opacity="0.3"/>

                        <TextBlock Text="Tags" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                 FontSize="12" TextWrapping="Wrap"/>

                        <TextBlock Text="Notes" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                 FontSize="12" AcceptsReturn="True" Height="80" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                        <ui:Button Content="Save" Command="{Binding SaveTagsCommand}" Margin="0,0,0,8"/>
                        <ui:Button Content="Open File Location" Command="{Binding OpenFileLocationCommand}" Margin="0,0,0,16"/>

                        <Border CornerRadius="4" Padding="10" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                            <TextBlock Text="Ctrl+C Copy | Ctrl+X Cut | Ctrl+V Paste | Del Delete | F2 Rename | F5 Refresh"
                                       FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.5"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Padding="12,8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ProgressBar Grid.Column="1" Width="200" Margin="0,0,16,0"
                                Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisibility}}"
                                Value="{Binding IndexProgress}" Maximum="100" Height="6"/>
                <ui:Button Grid.Column="1" Content="Cancel" Margin="0,0,16,0"
                           Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisibility}}"
                           Command="{Binding CancelIndexCommand}"/>
                <TextBlock Grid.Column="2" Text="{Binding FileCountText}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Page>