<ui:FluentWindow
    x:Class="FluxDB.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    mc:Ignorable="d"
    Title="FluxDB - File Database Manager"
    Height="750" Width="1400"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round"
    AllowDrop="True"
    Drop="Window_Drop"
    DragOver="Window_DragOver"
    PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="520" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Drop Overlay -->
            <Border x:Name="dropOverlay" Grid.RowSpan="6" Grid.ColumnSpan="3"
                    Background="#80000000" Visibility="Collapsed" Panel.ZIndex="100">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        BorderThickness="3" CornerRadius="16" Margin="50" Padding="40">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="[+]" FontSize="64" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" FontWeight="Bold"/>
                        <TextBlock x:Name="txtDropHint" Text="Drop folder here to index"
                                   FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,20,0,0"/>
                        <TextBlock Text="Hold SHIFT to move instead of copy"
                                   FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Opacity="0.7" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Header -->
            <Border Grid.Row="0" Grid.Column="0" Padding="20,15" Margin="20,0,0,0" CornerRadius="8,8,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Database24" FontSize="24"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                        <TextBlock Text=" FluxDB" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <TextBlock x:Name="txtCurrentFolder" Text="" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="20,0,0,0" Opacity="0.7"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button x:Name="btnSelectFolder" Content="Select Folder"
                                   Margin="0,0,10,0" Appearance="Primary"
                                   Click="BtnSelectFolder_Click" />
                        <ui:Button x:Name="btnRefresh" Content="Refresh" Margin="0,0,10,0"
                                   IsEnabled="False" Click="BtnRefresh_Click" />
                        <ui:Button x:Name="btnSettings" Content="Settings"
                                   Click="BtnSettings_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Navigation Bar -->
            <Border Grid.Row="1" Grid.Column="0" Padding="20,10" Margin="20,0,0,0" CornerRadius="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button x:Name="btnBack" ToolTip="Back (Alt+Left)"
                               IsEnabled="False" Click="BtnBack_Click"
                               Appearance="Transparent" />
                    <ui:Button x:Name="btnForward" Grid.Column="1" ToolTip="Forward (Alt+Right)"
                               IsEnabled="False" Click="BtnForward_Click" Margin="5,0,0,0"
                               Appearance="Transparent" />
                    <ui:Button x:Name="btnUp" Grid.Column="2" ToolTip="Up (Alt+Up)"
                               IsEnabled="False" Click="BtnUp_Click" Margin="5,0,15,0"
                               Appearance="Transparent" />

                    <ScrollViewer Grid.Column="3" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="pnlBreadcrumbs" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="15,0,0,0">
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:Name="cmbFilter" Width="120"
                                  SelectionChanged="CmbFilter_SelectionChanged">
                            <ComboBoxItem Content="All Files" IsSelected="True"/>
                            <ComboBoxItem Content="Images"/>
                            <ComboBoxItem Content="Audio"/>
                            <ComboBoxItem Content="Video"/>
                            <ComboBoxItem Content="Documents"/>
                            <ComboBoxItem Content="Archives"/>
                            <ComboBoxItem Content="Code"/>
                            <ComboBoxItem Content="Tags"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Search Bar -->
            <Border Grid.Row="2" Grid.Column="0" Padding="20,10" Margin="20,0,0,0" CornerRadius="0,0,8,8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtSearch" KeyUp="TxtSearch_KeyUp"
                             FontSize="14" Padding="10,8"/>
                    <ui:Button Grid.Column="1" x:Name="btnSearch" Content="Search"
                               Appearance="Primary" Click="BtnSearch_Click" Margin="10,0,0,0"/>
                    <ui:Button Grid.Column="2" x:Name="btnClearSearch" Content="Clear"
                               Click="BtnClearSearch_Click" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Files DataGrid -->
            <Border Grid.Row="3" Grid.Column="0" Margin="20,10,0,0" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <DataGrid x:Name="dgFiles"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionChanged="DgFiles_SelectionChanged"
                              MouseDoubleClick="DgFiles_MouseDoubleClick"
                              Sorting="DgFiles_Sorting"
                              Background="Transparent"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              FontSize="13"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              RowHeight="28">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <EventSetter Event="MouseRightButtonDown" Handler="ColumnHeader_RightClick"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="ContextMenu_Open" FontWeight="Bold"/>
                                <MenuItem Header="Open File Location" Click="ContextMenu_OpenLocation"/>
                                <Separator/>
                                <MenuItem Header="Copy (Ctrl+C)" Click="ContextMenu_Copy"/>
                                <MenuItem Header="Cut (Ctrl+X)" Click="ContextMenu_Cut"/>
                                <MenuItem Header="Paste (Ctrl+V)" Click="ContextMenu_Paste"/>
                                <Separator/>
                                <MenuItem Header="Rename (F2)" Click="ContextMenu_Rename"/>
                                <MenuItem Header="Delete (Del)" Click="ContextMenu_Delete" Foreground="#f44336"/>
                                <Separator/>
                                <MenuItem Header="New Folder" Click="ContextMenu_NewFolder"/>
                                <Separator/>
                                <MenuItem Header="Properties" Click="ContextMenu_Properties"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="28" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="16"
                                                       Foreground="{Binding IconColorBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" SortMemberPath="Name"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="80" SortMemberPath="TypeDisplay"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="100" SortMemberPath="Size"/>
                            <DataGridTextColumn Header="Tags" Binding="{Binding TagsText}" Width="120" CanUserSort="False"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140" SortMemberPath="ModifiedAt"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            <!-- Details & Preview Panel -->
            <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="2" Margin="0,0,20,0" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Preview Panel -->
                        <Border x:Name="pnlPreview" Grid.Row="0" CornerRadius="6" Margin="0,0,0,15"
                                Visibility="Collapsed"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                            <Grid>
                                <ScrollViewer x:Name="imgPreviewContainer" Margin="10"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="ImgPreviewContainer_PreviewMouseWheel">
                                    <Image x:Name="imgPreview" Stretch="None" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Top">
                                        <Image.LayoutTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Image.LayoutTransform>
                                    </Image>
                                </ScrollViewer>
                                <wpf:WebView2 x:Name="webPdfPreview" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="txtPreviewScroll" Visibility="Collapsed" Margin="10">
                                    <TextBox x:Name="txtPreview" IsReadOnly="True"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                             BorderThickness="0" FontFamily="Consolas" FontSize="11"
                                             TextWrapping="Wrap" AcceptsReturn="True"/>
                                </ScrollViewer>
                                <TextBlock x:Name="txtNoPreview" Text="No Preview Available"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Opacity="0.5" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Details Panel -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="pnlDetails">
                                <TextBlock Text="Details" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                           Margin="0,0,0,15"/>
                                <TextBlock Text="No file selected" x:Name="txtNoSelection"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Opacity="0.5"/>
                                <StackPanel x:Name="pnlMultiSelection" Visibility="Collapsed">
                                    <TextBlock x:Name="txtMultiCount" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtMultiTotalSize" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="txtMultiTypes" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,12" TextWrapping="Wrap"/>
                                    <ui:Button Content="Batch Assign Tags" Margin="0,0,0,6"
                                               Click="BtnBatchTags_Click" />
                                    <ui:Button Content="Delete Selected" Margin="0,0,0,6"
                                               Foreground="#f44336" Click="BtnBatchDelete_Click" />
                                    <ui:Button Content="Copy Selected" Margin="0,0,0,6"
                                               Click="BtnBatchCopy_Click" />
                                </StackPanel>
                                <StackPanel x:Name="pnlFileDetails" Visibility="Collapsed">
                                    <TextBlock Text="Name" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.7"/>
                                    <TextBlock x:Name="txtFileName" FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" Margin="0,3,0,12"/>

                                    <TextBlock Text="Tags" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.7"/>
                                    <Border CornerRadius="4" Padding="6" Margin="0,3,0,8"
                                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                            MinHeight="32">
                                        <WrapPanel x:Name="pnlTagChips" Margin="0,0,0,0"/>
                                    </Border>
                                    <TextBox x:Name="txtTagInput" Margin="0,0,0,8"
                                             FontSize="12" Height="26" AcceptsReturn="False"
                                             KeyDown="TxtTagInput_KeyDown"
                                             ToolTip="Type tag and press Enter"/>
                                    <Popup x:Name="tagAutocompletePopup" StaysOpen="False"
                                           PlacementTarget="{Binding ElementName=txtTagInput}"
                                           Placement="Bottom" Width="200">
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="4">
                                            <ListBox x:Name="tagAutocompleteList" MaxHeight="150"
                                                     SelectionChanged="TagAutocompleteList_SelectionChanged"
                                                     Background="Transparent" BorderThickness="0"/>
                                        </Border>
                                    </Popup>

                                    <TextBlock Text="Notes" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.7"/>
                                    <TextBox x:Name="txtNotes" Margin="0,3,0,12"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             Height="80" FontSize="12" VerticalScrollBarVisibility="Auto"/>

                                    <ui:Button x:Name="btnSaveTags" Content="Save"
                                               Appearance="Primary" Click="BtnSaveTags_Click" Margin="0,0,0,8"/>

                                    <Separator Margin="0,5,0,15" Opacity="0.3"/>

                                    <TextBlock Text="Path" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.7"/>
                                    <TextBox x:Name="txtFilePath" FontSize="11"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                             Background="Transparent" BorderThickness="0"
                                             IsReadOnly="True" TextWrapping="Wrap" Margin="0,3,0,12"/>

                                    <TextBlock Text="Size" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.7"/>
                                    <TextBlock x:Name="txtFileSize" FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,12"/>

                                    <TextBlock Text="Created" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.7"/>
                                    <TextBlock x:Name="txtFileCreated" FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,12"/>

                                    <TextBlock Text="Modified" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.7"/>
                                    <TextBlock x:Name="txtFileModified" FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,12"/>

                                    <ui:Button x:Name="btnOpenFile" Content="Open Location"
                                               Click="BtnOpenFile_Click" Margin="0,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Keyboard Shortcuts Info -->
                        <Border Grid.Row="2" CornerRadius="4" Padding="10" Margin="0,10,0,0"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                            <TextBlock Text="Ctrl+C Copy | Ctrl+X Cut | Ctrl+V Paste | Del Delete | F2 Rename | F5 Refresh"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Opacity="0.5" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

            <!-- Progress Bar -->
            <Border Grid.Row="4" Grid.ColumnSpan="3" Padding="20,10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    x:Name="pnlProgress" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtProgressStatus" Text="Indexing..."
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                        <ui:Button Grid.Column="1" x:Name="btnCancelIndex" Content="Cancel"
                                   Click="BtnCancelIndex_Click" />
                    </Grid>
                    <ProgressBar x:Name="progressBar" Height="6" Margin="0,8,0,0"
                                 Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                 BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="5" Grid.ColumnSpan="3" Padding="20,10"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtStatus"
                               Text="Ready - Select a folder or drag &amp; drop to start"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock x:Name="txtFileCount" Text="0 files"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" Grid.Column="1" FontSize="12"/>
                </Grid>
            </Border>

            <!-- Toast Notification -->
            <Border x:Name="toastNotification" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,40" CornerRadius="8" Padding="12,8"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    Visibility="Collapsed" Panel.ZIndex="150">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="toastText" Foreground="White" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ui:Button x:Name="btnToastClose" Content="×" Width="20" Height="20" Padding="0"
                               Appearance="Transparent" Foreground="White" FontSize="14"
                               Click="BtnToastClose_Click"/>
                </StackPanel>
            </Border>

            <!-- Keyboard Shortcut Cheat Sheet Overlay -->
            <Border x:Name="cheatSheetOverlay" Grid.RowSpan="6" Grid.ColumnSpan="3"
                    Background="#80000000" Visibility="Collapsed" Panel.ZIndex="200"
                    MouseLeftButtonDown="CheatSheetOverlay_MouseLeftButtonDown">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        BorderThickness="2" CornerRadius="12"
                        Width="550" MaxHeight="500" Padding="25"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <TextBlock Text="Keyboard Shortcuts" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <TextBlock Text="Ctrl+K to toggle" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Opacity="0.5" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Navigation" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Alt+Left" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Alt+Right" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Alt+Up" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Backspace" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Enter" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Go back" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Go forward" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Go up" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Go up" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Open selected item" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="File Operations" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Ctrl+C" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Ctrl+X" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Ctrl+V" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Del" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="F2" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Copy" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Cut" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Paste" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Delete" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Rename" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Search &amp; Tools" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Ctrl+F" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="F5" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="F8" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Ctrl+K" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Esc" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Search" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Refresh" FontSize="12"
