<ui:FluentWindow
    x:Class="FluxDB.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Settings" Height="560" Width="600"
    WindowStartupLocation="CenterOwner"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" />

        <Grid Grid.Row="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <TabControl Background="Transparent" BorderThickness="0,1,0,0">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Appearance" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Theme:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="cmbTheme" Width="200"
                                      SelectionChanged="CmbTheme_SelectionChanged"/>
                        </Grid>


                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Current Version:" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="txtCurrentVersion" Text="0.0.0"
                                       VerticalAlignment="Center" FontWeight="Bold"/>
                        </Grid>

                        <CheckBox x:Name="chkAutoUpdate"
                                  Content="Automatically check for updates on startup"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  Margin="0,0,0,8"/>

                        <Separator Margin="0,5,0,12" Opacity="0.3"/>

                        <TextBlock Text="Updates" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                        <Border Padding="15" CornerRadius="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="txtUpdateStatus" Text="Checking for updates..." FontSize="14"/>
                                        <TextBlock x:Name="txtUpdateDetails" FontSize="11" Opacity="0.6"
                                                   Margin="0,5,0,0" Visibility="Collapsed"/>
                                        <TextBlock x:Name="txtBetaWarning" FontSize="11" Foreground="Orange"
                                                   Text="⚠ This is a beta update!" Margin="0,5,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" x:Name="btnDownloadUpdate"
                                               Content="Update Now" Appearance="Primary"
                                               Visibility="Collapsed" Click="BtnDownloadUpdate_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,5,0,12" Opacity="0.3"/>

                        <TextBlock Text="Feedback" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>

                        <Border Padding="15" CornerRadius="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="Found a bug or have an idea for a new feature? Let us know!"
                                           FontSize="11" Opacity="0.6" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button x:Name="btnReportBug" Content="Report a Bug" Width="150"
                                               Margin="0,0,10,0" Click="BtnReportBug_Click"/>
                                    <ui:Button x:Name="btnNewFeature" Content="Suggest a Feature" Width="150"
                                               Click="BtnNewFeature_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Made with ❤️ from vynOFC with service-runner.org"
                                   FontSize="10" Opacity="0.5" Margin="0,12,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Preferences">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="Search" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>

                        <Border Padding="15" CornerRadius="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <CheckBox x:Name="chkSearchInPath"
                                          Content="Include folder names in search (slower, finds files inside matching folders)"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Margin="0,0,0,5"/>
                                <TextBlock Text="When enabled, searching for a term will also match files located in folders whose name contains the term. When disabled, only file names, notes and tags are searched."
                                           FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Data">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="Export / Import" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>

                        <Border Padding="15" CornerRadius="4" Margin="0,0,0,15"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="Export" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="Export the current index as JSON or compressed JSON."
                                           FontSize="11" Opacity="0.6" Margin="0,0,0,10"/>
                                <ui:Button x:Name="btnExport" Content="Export Index..." Width="150"
                                           Click="BtnExport_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="15" CornerRadius="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="Import" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="Import a previously exported index file. Existing entries will be updated, new entries will be added."
                                           FontSize="11" Opacity="0.6" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <ui:Button x:Name="btnImport" Content="Import Index..." Width="150"
                                           Click="BtnImport_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Persistence">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="Remember UI State" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>

                        <TextBlock Text="Choose what FluxDB saves to settings.json so your workspace is restored next time."
                                   FontSize="11" Opacity="0.6" Margin="0,0,0,15" TextWrapping="Wrap"/>

                        <Border Padding="15" CornerRadius="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <CheckBox x:Name="chkPersistLastRootFolder"
                                          Content="Last root folder (reopen the last indexed folder on startup)"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Margin="0,0,0,10"/>
                                <CheckBox x:Name="chkPersistLastViewFolder"
                                          Content="Last viewed subfolder (restore the exact folder you were browsing)"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Margin="0,0,0,10"/>
                                <CheckBox x:Name="chkPersistFilter"
                                          Content="File type filter (per folder)"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Margin="0,0,0,10"/>
                                <CheckBox x:Name="chkPersistSort"
                                          Content="Sort column and direction (per folder)"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Margin="0,0,0,10"/>
                                <CheckBox x:Name="chkPersistColumnVisibility"
                                          Content="Column visibility (which columns are shown/hidden)"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Margin="0,0,0,10"/>
                                <CheckBox x:Name="chkPersistRecentFolders"
                                          Content="Recent folders list (dashboard)"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <ui:Button Content="Cancel" Width="100" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <ui:Button Content="Save Settings" Width="120" Appearance="Primary" Click="BtnSave_Click"/>
        </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>