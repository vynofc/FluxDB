<ui:FluentWindow
    x:Class="FluxDB.Views.DevSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Developer Settings" Height="560" Width="720"
    WindowStartupLocation="CenterOwner"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" />

        <Grid Grid.Row="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="pnlPassword" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                <TextBlock Text="Zugriff geschützt" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                <TextBlock Text="Bitte Passwort eingeben, um die Developer Settings zu öffnen."
                           FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,12"/>
                <PasswordBox x:Name="pwdDevSettings" Padding="6,4,6,4"
                             KeyDown="PwdDevSettings_KeyDown"/>
                <TextBlock x:Name="txtPasswordError" Text="Falsches Passwort." FontSize="11"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Visibility="Collapsed" Margin="0,6,0,0"/>
                <ui:Button x:Name="btnUnlock" Content="Entsperren" Margin="0,12,0,0"
                           Appearance="Primary" Click="BtnUnlock_Click"/>
            </StackPanel>

            <StackPanel x:Name="pnlHeader" Grid.Row="0" Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock Text="Developer Settings" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                <TextBlock Text="Erweiterte interne Einstellungen. Änderungen werden sofort gespeichert und greifen nach Neustart bzw. beim nächsten Aufruf."
                           FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <TabControl x:Name="tabContent" Grid.Row="1" Visibility="Collapsed">
                <TabItem Header="Einstellungen">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel x:Name="pnlSettings"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Gerät">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel>
                            <Border Padding="12,10,12,10" CornerRadius="6" Margin="0,0,0,8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel>
                                    <TextBlock Text="Geräte-ID" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <TextBlock Text="Pseudonyme ID dieses Geräts. Wird für Diagnose und zukünftige Sync-Features verwendet. Überlebt Reinstall und Settings-Reset."
                                               FontSize="11" Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtDeviceId" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                                 VerticalAlignment="Center" Padding="6,3,6,3"/>
                                        <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="8,0,0,0">
                                            <ui:Button x:Name="btnCopyDeviceId" Content="Kopieren"
                                                       Appearance="Secondary" Click="BtnCopyDeviceId_Click"/>
                                            <ui:Button x:Name="btnResetDeviceId" Content="Zurücksetzen" Margin="8,0,0,0"
                                                       Appearance="Secondary" Click="BtnResetDeviceId_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Padding="12,10,12,10" CornerRadius="6" Margin="0,0,0,8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel>
                                    <TextBlock Text="System" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <StackPanel x:Name="pnlSystemInfo" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="12,10,12,10" CornerRadius="6" Margin="0,0,0,8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel>
                                    <TextBlock Text="Pfade" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <StackPanel x:Name="pnlPathInfo" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <StackPanel x:Name="pnlFooter" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" Visibility="Collapsed">
                <ui:Button x:Name="btnReset" Content="Reset to Defaults" Margin="4,0"
                           Appearance="Secondary" Click="BtnReset_Click"/>
                <ui:Button x:Name="btnClose" Content="Close" Margin="4,0"
                           Appearance="Primary" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
