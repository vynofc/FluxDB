<ui:FluentWindow
    x:Class="FluxDB.Views.DevSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Developer Settings" Height="560" Width="720"
    WindowStartupLocation="CenterOwner"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" />

        <Grid Grid.Row="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Developer Settings" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                <TextBlock Text="Erweiterte interne Einstellungen. Änderungen werden sofort gespeichert und greifen nach Neustart bzw. beim nächsten Aufruf."
                           FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="pnlSettings"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <ui:Button x:Name="btnReset" Content="Reset to Defaults" Margin="4,0"
                           Appearance="Secondary" Click="BtnReset_Click"/>
                <ui:Button x:Name="btnClose" Content="Close" Margin="4,0"
                           Appearance="Primary" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
