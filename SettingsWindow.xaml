<Window x:Class="FluxDB.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings &amp; License" Height="500" Width="550" WindowStartupLocation="CenterOwner"
        Background="#1e1e1e" Foreground="#cccccc">
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1e1e1e"/>
        <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#252526"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3c3c3c"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#cccccc"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0078d4"/>
        
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                    <Setter Property="Padding" Value="15,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0,0,0,2" Margin="0,0,10,0">
                                    <ContentPresenter x:Name="ContentSite" ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#2d2d30"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="General">
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="Appearance" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="{StaticResource AccentBrush}"/>
                    
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Current Version:" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="txtCurrentVersion" Text="0.0.0" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Theme:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="cmbTheme" Width="200" HorizontalAlignment="Left" Background="{StaticResource SecondaryBackgroundBrush}" Foreground="{StaticResource ForegroundBrush}">
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="Light"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Preview scale:" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="txtPreviewScale" Width="60" Style="{StaticResource TextBoxStyle}"/>
                            <TextBlock Text=" (0.3 - 3.0)" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.6" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,10,0,20"/>

                    <TextBlock Text="Updates" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="{StaticResource AccentBrush}"/>
                    <Border Background="{StaticResource SecondaryBackgroundBrush}" Padding="15" CornerRadius="4">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="txtUpdateStatus" Text="Checking for updates..." FontSize="14"/>
                                    <TextBlock x:Name="txtUpdateDetails" Text="Program started with --noupdate. Check here for new versions." FontSize="11" Opacity="0.6" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="btnDownloadUpdate" Content="Download Update" Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed" Click="BtnDownloadUpdate_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="License">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="License Management" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock Text="Device ID" FontSize="11" Opacity="0.7"/>
                        <Grid Margin="0,5,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtDeviceId" Style="{StaticResource TextBoxStyle}" IsReadOnly="True"/>
                            <Button Grid.Column="1" x:Name="btnCopyDeviceId" Content="Copy" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="BtnCopyDeviceId_Click"/>
                        </Grid>

                        <TextBlock Text="License Key" FontSize="11" Opacity="0.7"/>
                        <TextBox x:Name="txtLicenseKey" Style="{StaticResource TextBoxStyle}" Margin="0,5,0,10"/>
                        <Button x:Name="btnActivate" Content="Activate License" Style="{StaticResource PrimaryButtonStyle}" Click="BtnActivate_Click"/>

                        <Border Background="{StaticResource SecondaryBackgroundBrush}" CornerRadius="4" Padding="15" Margin="0,20,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Status:" Opacity="0.7" Margin="0,0,20,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtLicenseStatus" Text="Not activated"/>

                                <TextBlock Grid.Row="1" Text="Expires:" Opacity="0.7" Margin="0,0,20,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtLicenseExpires" Text="-"/>

                                <TextBlock Grid.Row="2" Text="Last Check:" Opacity="0.7" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtLastCheck" Text="-"/>
                            </Grid>
                        </Border>

                        <Button x:Name="btnClearLicense" Content="Clear License" Style="{StaticResource SecondaryButtonStyle}" Click="BtnClearLicense_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Width="100" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Save Settings" Width="120" Style="{StaticResource PrimaryButtonStyle}" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>