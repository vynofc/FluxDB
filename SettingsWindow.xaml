<Window x:Class="FluxDB.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="300" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0">
            <TextBlock Text="Appearance" FontWeight="Bold" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Theme:" VerticalAlignment="Center" Width="80"/>
                <ComboBox x:Name="cmbTheme" Width="200">
                    <ComboBoxItem Content="Dark" IsSelected="True"/>
                    <ComboBoxItem Content="Light"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Preview scale:" VerticalAlignment="Center" Width="80"/>
                <TextBox x:Name="txtPreviewScale" Width="80"/>
                <TextBlock Text=" (0.3 - 3.0)" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.7"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Content="Save" Width="80" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>