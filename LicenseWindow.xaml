<Window x:Class="FluxDB.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="License Management" Height="450" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1e1e1e"/>
        <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#252526"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3c3c3c"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#cccccc"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0078d4"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#4caf50"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#f44336"/>
        
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1e88e5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3c3c3c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="30">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="?? License Management" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,30"/>
            
            <!-- Device ID -->
            <TextBlock Text="Device ID" FontSize="12" Foreground="{StaticResource ForegroundBrush}" Opacity="0.7"/>
            <Grid Margin="0,5,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtDeviceId" Style="{StaticResource TextBoxStyle}" IsReadOnly="True"/>
                <Button Grid.Column="1" x:Name="btnCopyDeviceId" Content="Copy" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCopyDeviceId_Click" Margin="10,0,0,0" Padding="10,8"/>
            </Grid>
            
            <!-- License Key Input -->
            <TextBlock Text="License Key" FontSize="12" Foreground="{StaticResource ForegroundBrush}" Opacity="0.7"/>
            <TextBox x:Name="txtLicenseKey" Style="{StaticResource TextBoxStyle}" Margin="0,5,0,10"/>
            
            <!-- Activate Button -->
            <Button x:Name="btnActivate" Content="Activate License" Style="{StaticResource PrimaryButtonStyle}" Click="BtnActivate_Click"/>
            
            <!-- License Status -->
            <Border Background="{StaticResource SecondaryBackgroundBrush}" CornerRadius="8" Padding="20" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="License Status" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,15"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" Foreground="{StaticResource ForegroundBrush}" Opacity="0.7" Margin="0,0,20,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtLicenseStatus" Text="Not activated" Foreground="{StaticResource ForegroundBrush}"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Expires:" Foreground="{StaticResource ForegroundBrush}" Opacity="0.7" Margin="0,0,20,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtLicenseExpires" Text="-" Foreground="{StaticResource ForegroundBrush}"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Check:" Foreground="{StaticResource ForegroundBrush}" Opacity="0.7" Margin="0,0,20,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtLastCheck" Text="-" Foreground="{StaticResource ForegroundBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- Upload Index Button -->
            <Button x:Name="btnUploadIndex" Content="?? Upload Index to Server" Style="{StaticResource SecondaryButtonStyle}" Click="BtnUploadIndex_Click" Margin="0,20,0,0" IsEnabled="False"/>
            
            <!-- Clear License -->
            <Button x:Name="btnClearLicense" Content="Clear License" Style="{StaticResource SecondaryButtonStyle}" Click="BtnClearLicense_Click" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
